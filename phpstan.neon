
parameters:
	scanFiles:
		- tests/Fixtures/MenuOwnerContract.php
		- tests/Fixtures/MenuWorkspaceOwnerContract.php
		- tests/Fixtures/OptionalMenuRepository.php
	level: 10
	paths:
		- src
		- views
		- heartphrame-manifest.php
	ignoreErrors:
		-
			identifier: property.protected
			path: views
	tmpDir: build/phpstan
	treatPhpDocTypesAsCertain: false
