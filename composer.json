{
    "name": "aaieduhr/simbioza-module-workspace",
    "description": "Workspace and hierarchical content organization module for Simbioza",
    "type": "heartphrame-module",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "EUPL-1.2",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-backup.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-api.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "aaieduhr/heartphrame-framework": "^0.0.24",
        "aaieduhr/heartphrame-module-auth": "^0.1.0",
        "aaieduhr/heartphrame-module-orm": "^0.1.0"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-backup": "Adds complete site backup and scoped Workspace backup/import with ACL, trees, themes, and related content.",
        "aaieduhr/heartphrame-module-editor-html": "Enables Workspace-owned HTML pages and editing.",
        "aaieduhr/heartphrame-module-api": "Exposes ACL-aware Workspace resources through the versioned HTTP API.",
        "aaieduhr/heartphrame-module-menu": "Adds Workspace entries to the application and settings menus.",
        "aaieduhr/heartphrame-module-notification": "Notifies publishers about review requests and authors about publication.",
        "aaieduhr/heartphrame-module-email": "Sends optional e-mail copies through the Notification module.",
        "aaieduhr/heartphrame-module-theme": "Adds isolated per-Workspace themes and includes them in portable HTML exports."
    },
    "require-dev": {
        "aaieduhr/heartphrame-module-api": "^0.1.0",
        "aaieduhr/heartphrame-module-backup": "^0.1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3",
        "slevomat/coding-standard": "^8"
    },
    "autoload": {
        "psr-4": {
            "AaiEduHr\\SimbiozaModuleWorkspace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AaiEduHr\\SimbiozaModuleWorkspace\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/OptionalNotificationService.php"
        ]
    },
    "authors": [
        {
            "name": "Srce",
            "email": "aai@srce.hr"
        }
    ],
    "config": {
        "github-protocols": [
            "https"
        ],
        "use-github-api": false,
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector --clear-cache",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run --clear-cache",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
